# Copy this file to .env (or just edit the .env that's already included)
# and paste ONE key below. The app works WITHOUT any key too — it
# automatically falls back to template-based message generation if no
# key is found or a call fails.
#
# Only fill in ONE provider. Priority order if multiple are set:
#   Groq -> Gemini -> OpenAI

# --- Option A: Groq (FREE, fast) -----------------------------------------
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Option B: Google Gemini (FREE tier) ----------------------------------
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Option C: OpenAI (paid) ----------------------------------------------
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
